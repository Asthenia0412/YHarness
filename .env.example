# YHarness AI Provider Configuration
# Copy this file as .env and fill in your actual values
YHARNESS_PROVIDER_TYPE=MOCK
YHARNESS_API_KEY=your-actual-api-key-here
YHARNESS_BASE_URL=https://api.openai.com/v1
YHARNESS_MODEL=gpt-4o
YHARNESS_TIMEOUT=30000
YHARNESS_MAX_TOKENS=4096
YHARNESS_TEMPERATURE=0.7
YHARNESS_SERVER_PORT=8080